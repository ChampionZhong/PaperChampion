APP_ENV=production
APP_NAME=PaperChampion API
API_HOST=0.0.0.0
API_PORT=8000

DATABASE_URL=sqlite:///./data/paperchampion.db

PDF_STORAGE_ROOT=./data/papers
BRIEF_OUTPUT_ROOT=./data/briefs
SKIM_SCORE_THRESHOLD=0.65
USER_TIMEZONE=Asia/Shanghai

# Docker deployment: use * for local-only testing or provide explicit origins.
CORS_ALLOW_ORIGINS=*

# LLM Provider: openai / anthropic / zhipu
LLM_PROVIDER=zhipu

# OpenAI
OPENAI_API_KEY=
# Anthropic
ANTHROPIC_API_KEY=
# ZhipuAI
ZHIPU_API_KEY=

SEMANTIC_SCHOLAR_API_KEY=
# OpenAlex email for the polite pool.
OPENALEX_EMAIL=

LLM_MODEL_SKIM=glm-4.7
LLM_MODEL_DEEP=glm-4.7
LLM_MODEL_VISION=glm-4.6v
LLM_MODEL_FALLBACK=glm-4.7
EMBEDDING_MODEL=embedding-3

COST_GUARD_ENABLED=true
PER_CALL_BUDGET_USD=0.05
DAILY_BUDGET_USD=2.0

# ==========================================
# Site authentication
# ==========================================

# Leave empty to disable authentication.
AUTH_PASSWORD=

# Change this to a strong random value in production.
AUTH_SECRET_KEY=change-me-use-a-strong-random-value

# ==========================================
# SMTP email
# ==========================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NOTIFY_DEFAULT_TO=

# ==========================================
# Scheduler settings in UTC
# ==========================================

# Daily report time. Example: UTC 04:00 = Beijing 12:00.
DAILY_CRON=0 4 * * *

# Weekly graph maintenance. Example: UTC Sunday 22:00 = Beijing Monday 06:00.
WEEKLY_CRON=0 22 * * 0

# Default topic fetch hour in UTC, 0-23.
DEFAULT_TOPIC_TIME_UTC=2

# Maximum deep reads per topic run.
DEFAULT_MAX_DEEP_READS=2

# ==========================================
# Idle processor
# ==========================================

IDLE_PROCESSOR_ENABLED=true
IDLE_BATCH_SIZE=5
IDLE_CHECK_INTERVAL=60
IDLE_CPU_THRESHOLD=30.0
IDLE_MEMORY_THRESHOLD=70.0
IDLE_REQUEST_THRESHOLD=5

# ==========================================
# Worker retry settings
# ==========================================

WORKER_RETRY_MAX=3
WORKER_RETRY_BASE_DELAY=5.0

# ArXiv request interval in seconds. Keep at 5-6 seconds to reduce 429s.
ARXIV_REQUEST_DELAY_SEC=5.0
